@using Osmo.Common.Database.Models
@using Osmo.ConneX.Ui.Components

@if (!_loading)
{
    <div class="row">
        <MudText Typo="Typo.h3" Class="mb-3" Style="display: flex; align-items: center;">
            <MudIcon Size="Size.Large" Icon="@Icons.Material.Filled.Work" Class="mr-2" /> Job Details
        </MudText>

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudPaper Class="p-3">
                    <MudText Typo="Typo.subtitle2" Class="text-secondary">Job Name</MudText>
                    <MudText Typo="Typo.h6" Style="overflow-wrap: break-word;">@_job.JobName</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudPaper Class="p-3">
                    <MudText Typo="Typo.subtitle2" Class="text-secondary">Job ID</MudText>
                    <MudText Typo="Typo.h6" Style="overflow-wrap: anywhere;">@_job.GivenJobId</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Class="p-3">
                    <MudText Typo="Typo.subtitle2" Class="text-secondary">Job Description</MudText>
                    <MudText Typo="Typo.body1" Style="overflow-wrap: break-word;">@_job.JobDescription</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudPaper Class="p-3">
                    <MudText Typo="Typo.subtitle2" Class="text-secondary">Job Checksum</MudText>
                    <MudText Typo="Typo.h6" Style="overflow-wrap: anywhere;">@_job.JobChecksum</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudPaper Class="p-3">
                    <MudText Typo="Typo.subtitle2" Class="text-secondary">Settings Checksum</MudText>
                    <MudText Typo="Typo.h6" Style="overflow-wrap: anywhere;">@_job.SettingChecksum</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </div>
    
    <h3 class="mt-4">Overall Job Statistics</h3>
    <div class="row mt-4">
        <div class="col-lg-3 col-sm-12">
            
            <MudCard Outlined="true">
                <MudCardContent>
                    <div style="display: flex; align-items: center;">
                        <MudIcon Size="Size.Large" 
                                 Style="font-size: 4rem;" 
                                 Class="mr-4" 
                                 Icon="@Icons.Material.Filled.Analytics"
                                 Color="Color.Info"/>
                        <div>
                            <MudText Typo="Typo.h4">@_jobStats.total_jobs</MudText>
                            <MudText Typo="Typo.subtitle2">Total run count</MudText>    
                        </div>
                        
                    </div>
                </MudCardContent>
            </MudCard>
        </div>
        <div class="col-lg-3 col-sm-12">

            <MudCard Outlined="true">
                <MudCardContent>
                    <div style="display: flex; align-items: center;">
                        <MudIcon Size="Size.Large"
                                 Style="font-size: 4rem;"
                                 Class="mr-4"
                                 Icon="@Icons.Material.Filled.Check"
                                 Color="Color.Success"/>
                        <div>
                            <MudText Typo="Typo.h4">@_jobStats.total_success</MudText>
                            <MudText Typo="Typo.subtitle2">Total successful runs</MudText>
                        </div>

                    </div>
                </MudCardContent>
            </MudCard>
        </div>
        <div class="col-lg-3 col-sm-12">

            <MudCard Outlined="true">
                <MudCardContent>
                    <div style="display: flex; align-items: center;">
                        <MudIcon Size="Size.Large"
                                 Style="font-size: 4rem;"
                                 Class="mr-4"
                                 Icon="@Icons.Material.Filled.Error"
                                 Color="Color.Error"/>
                        <div>
                            <MudText Typo="Typo.h4">@_jobStats.total_failures</MudText>
                            <MudText Typo="Typo.subtitle2">Total failure runs</MudText>
                        </div>

                    </div>
                </MudCardContent>
            </MudCard>
        </div>
        <div class="col-lg-3 col-sm-12">

            <MudCard Outlined="true">
                <MudCardContent>
                    <div style="display: flex; align-items: center;">
                        <MudIcon Size="Size.Large"
                                 Style="font-size: 4rem;"
                                 Class="mr-4"
                                 Icon="@Icons.Material.Filled.Percent"/>
                        <div>
                            @if (_jobStats.total_failures == 0)
                            {
                                <MudText Typo="Typo.h4">100.00%</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.h4">@Math.Round((double)_jobStats.total_success * 100 / _jobStats.total_jobs, 2)%</MudText>
                            }

                            <MudText Typo="Typo.subtitle2">Total success rate</MudText>
                        </div>

                    </div>
                </MudCardContent>
            </MudCard>
        </div>
    </div>
                    
    <h3 class="mt-4">Historical Job Performance</h3>
    
    <div class="row">
        <div class="col-lg-6 col-sm-12">
            <MudCard Outlined="true">
                <MudCardContent>
                    <h4 class="mt-4">Programming results</h4>
                    <MudChart ChartType="ChartType.Pie"
                              InputData="@_programmingResultCounts.Select(d => (double)d.occurrences).ToArray()"
                              InputLabels="@_programmingResultCounts.Select(d => $"{d.code} - {d.code_name}").ToArray()"
                              Width="300px"
                              Height="300px"/>
                </MudCardContent>
            </MudCard>
        </div>
        <div class="col-lg-6 col-sm-12">
            <MudCard Outlined="true">
                <MudCardContent>
                    <MudTable Items="@_programmingResultCounts" Hover="true" Breakpoint="Breakpoint.Sm" LoadingProgressColor="Color.Info">
                        <HeaderContent>
                            <MudTh>Code</MudTh>
                            <MudTh>Code Name</MudTh>
                            <MudTh>Occurrences</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Code">@context.code</MudTd>
                            <MudTd DataLabel="Code Name">@context.code_name</MudTd>
                            <MudTd DataLabel="Occurrences">@context.occurrences</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-12">
            <MudCard Outlined="true">
                <MudCardContent>
                    <h4 class="mt-4">Average Programming Duration</h4>
                    <TimeSeries ChartTitle="Average Programming Duration"
                                Trace="_programmingTimeTrace"
                                Class="my-2"/>
                </MudCardContent>
            </MudCard>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-12">
            <MudCard Outlined="true">
                <MudCardContent>
                    <h4 class="mt-4">Average Verify Duration</h4>
                    <TimeSeries ChartTitle="Average Verify Duration"
                                Trace="_verifyTimeTrace"
                                Class="my-2"/>
                </MudCardContent>
            </MudCard>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-12">
            <MudCard Outlined="true">
                <MudCardContent>
                    <h4 class="mt-4">Average Blank Check Duration</h4>
                    <TimeSeries ChartTitle="Average Blank Check Duration"
                                Trace="_blankCheckTimeTrace"
                                Class="my-2"/>
                </MudCardContent>
            </MudCard>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-12">
            <MudCard Outlined="true">
                <MudCardContent>
                    <h4 class="mt-4">Average Erase Duration</h4>
                    <TimeSeries ChartTitle="Average Erase Duration"
                                Trace="_eraseTimeTrace"
                                Class="my-2"/>
                </MudCardContent>
            </MudCard>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-12">
            <MudCard Outlined="true">
                <MudCardContent>
                    <h4 class="mt-4">Average Overhead Duration</h4>
                    <TimeSeries ChartTitle="Average Overhead Duration"
                                Trace="_overheadTimeTrace"
                                Class="my-2"/>
                </MudCardContent>
            </MudCard>
        </div>
    </div>
}